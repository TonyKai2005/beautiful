NODE_ENV=development
API_PORT=4175
PUBLIC_ORIGIN=http://localhost:4174

# Production PostgreSQL (omit locally to use persistent PGlite in .egain-data/)
# DATABASE_URL=postgresql://user:password@host:5432/egain

# Required before production project intake is enabled
# PRIVACY_NOTICE_URL=https://example.com/privacy
# BOOKING_URL=https://cal.example.com/egain/discovery

# SMTP belongs in server environment variables and is never exposed in Mission Control
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=e Gain Mission Control <mission-control@example.com>

# Optional one-time production administrator bootstrap (1234 and demo email are rejected)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-at-least-12-characters
